{
    "compilerOptions": {
        "outDir": "../dist",
        "baseUrl": "../src",
        "allowJs": true,
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "sourceMap": true,
        "skipLibCheck": true,
        //"strict": true,
        "lib": [
            "dom",
            "dom.iterable",
            "es2023",
        ],
        "paths": {
            "*": ["./*"],
            "_tests/*": ["./_tests/*"]
        }
    },
    "include": [
        "../src/*",
        "../src/_tests/*"
    ]
}
